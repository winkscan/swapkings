# Copy to .env.local (gitignored) and fill in real values before pointing the app
# at anything other than the local validator. Never commit .env.local — it can end
# up holding a paid RPC provider's API key in the URL.

# RPC endpoint the app connects to. Defaults to the local validator
# (http://127.0.0.1:8899) if unset. For real devnet/mainnet testing, use a paid
# provider (Helius/QuickNode/Triton) — the public mainnet RPC can't handle real
# traffic and will rate-limit or reject requests.
# VITE_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Cluster the Mobile Wallet Adapter (Seeker) reports to connecting wallets. Must
# match whatever network VITE_RPC_ENDPOINT actually points at, or a wallet will
# sign a transaction for the wrong chain. One of: mainnet-beta, devnet, testnet.
# VITE_CLUSTER=mainnet-beta

# URL of the swapkings-cache Cloudflare Worker (see ../cloudflare-worker) —
# serves the guild list / all-time volume / guild fee history from a cache
# refreshed once every 2 minutes server-side, instead of every visitor's own
# browser hitting Helius directly (see the 2026-08-21 Helius-cost audit in
# project memory). Falls back to direct Helius calls for these 3 datasets if
# unset, so this is optional for local dev against the local validator.
# VITE_CACHE_WORKER_URL=https://swapkings-cache.<your-subdomain>.workers.dev

# Jupiter Developer Platform API key (https://developers.jup.ag) for the
# swap quote/build calls in jupiter.ts (api.jup.ag, NOT the separate
# lite-api.jup.ag endpoints used elsewhere for token info/prices/discovery —
# those are a different product with their own limits, untouched by this).
# Keyless requests to api.jup.ag are capped at a shared 0.5 req/s across
# every anonymous caller worldwide — confirmed live 2026-08-22 as the real
# cause of frequent 429s during normal swap testing. A free key from the
# Developer Platform bumps this to a dedicated (not shared) 1 req/s, with
# paid tiers available if real traffic ever needs more. Works without one
# (falls back to the same shared keyless limit), so this is optional for
# local/light dev.
# VITE_JUPITER_API_KEY=jup_YOUR_KEY
